[Unit]
Description=Zene scoping briefs (read-only Luna) for upcoming features and bugs

[Service]
WorkingDirectory=/home/kruzzzzy/.local/share/zene-bunny-fix/qwen
Environment=PATH=/home/kruzzzzy/.local/bin:/home/kruzzzzy/.hermes/node/bin:/usr/local/bin:/usr/bin:/bin:/opt/cuda/bin
Environment=LANG=en_GB.UTF-8
Environment=QWEN_QA_WORKERS=2
Environment=QWEN_LUNA_WORKERS=4
Environment=BUNNY_SLOTS=2
Environment=QWEN_ENGINE=luna
ExecStartPre=/usr/bin/rm -f /home/kruzzzzy/.local/share/zene-bunny-fix/qwen/STOP-SCOPE
ExecStart=/usr/bin/python3 /home/kruzzzzy/.local/share/zene-bunny-fix/qwen/feature_scope.py --ahead 120 --workers 2 --bugs-ahead 12
Restart=on-failure
RestartSec=120
StandardOutput=append:/home/kruzzzzy/.local/share/zene-bunny-fix/qwen/logs/feature-scope.out
StandardError=append:/home/kruzzzzy/.local/share/zene-bunny-fix/qwen/logs/feature-scope.out

[Install]
WantedBy=default.target
