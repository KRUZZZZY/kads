# Zene fix/feature pipeline (owner 2026-10-25: "put the system on git").
# Tracks code, docs and the knob files the loops read live. Runs, logs, state, caches and secrets stay out.
# Default: ignore everything, then allow by type.
*
!*/
!.gitignore
!*.py
!*.sh
!*.md
!*.yaml
!*.yml
!*.attributes
!*.service
!*.timer
!*.desktop

# qwen knobs read live (no extension or JSON config)
!qwen/LUNA-CAP
!qwen/FIX-BASE
!qwen/FIX-ENGINE
!qwen/FIX-CMAKE-ARGS
!qwen/LIGHT-ENGINE
!qwen/PATROL-ENGINE
!qwen/CLAUDE-FIRST.txt
!qwen/AUTOSCALE.json
!qwen/BUG-PREFER.json
!qwen/DSH-HARNESS.json
!qwen/FEATURE-EVAL.json
!qwen/FEATURE-TIER-CUTS.json
!qwen/FEATURE-TIERS.json
!qwen/LANES.json
!qwen/MCODE-HARNESS.json
!qwen/MODEL-SCHEDULE.json
!qwen/MULTI-SESSION.json
!qwen/OPENCODE-FREE.json
!qwen/OPENCODE-VARIANTS.json
!qwen/PLANS-CONFIG.json
!qwen/QA-FIX.json
!qwen/WORKFLOW.json
!qwen/api-prices.json
!qwen/merge/BAR-JOBS
!qwen/merge/MERGE-EXCLUDE.txt
!qwen/merge/baseline-failures.txt
!bunny/JOBSERVER.json
!dsh/gitconfig

# never: backups, caches, environments, data and secrets
*.bak*
*.bak-*
*.pyc
__pycache__/
clef-venv/
.venv*/
venv/
node_modules/
*-backup-*/
backup-*/
qwen/runs/
qwen/qa/
qwen/state/
qwen/logs/
qwen/rework/
qwen/parked/
qwen/issues/
qwen/evidence/
qwen/diagnostics/
qwen/reports/
qwen/integrations/
qwen/integration-pending/
qwen/gate-baselines/
qwen/mcode-data/
qwen/opencode-locks/
qwen/workflow-migration/
qwen/audits/*/evidence.json
qwen/merge/*.log
qwen/merge/train-*/
bunny/mcode-data/
bunny/logs/
bunny/locks/
bunny/lanes/
dsh/home/
mcode/data/
smoke/
feature-lanes/
qwen/WORKFLOW-STATUS.md
# secrets (API keys inline) and generated reports
sb-config.yaml
qwen/BENCHMARK.md
qwen/FOLLOWUP-SWEEP.md
# extensionless build/tool shims
!bunny/shims/cmake
!bunny/shims/ctest
!bunny/shims/git
!bunny/shims/make
!bunny/shims/mcode
!bunny/shims/rg
!qwen/shims/mcode
!systemd/*
# knobs of the research/code-factories ports (2026-10-25)
!qwen/CONFIG-JOURNAL.json
!qwen/STUCK-DETECTOR.json
!qwen/SCOPE-GUARD.json
!qwen/REVIEW-DIVERSITY.json
!qwen/FRESHNESS-GATE.json
